**/.env.*

# Windows per-user pilot state is never part of an application image.
**/secrets
**/installation.json
**/pilot.env
**/*.previous

# Stock consultation signing material and private transfers
**/*.pem
**/*.vastock.json
**/*.vaprefs.json
**/*.vagrant.json
**/*.vareceipts.json
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.vatrust.json
**/*.varequest.json
**/publisher.env
**/publisher-installation.json

# Native build output and encrypted archives are not runtime source.
deploy/native/Host/bin
deploy/native/Host/obj
**/*.gvabackup
**/*.gvabackup.partial
