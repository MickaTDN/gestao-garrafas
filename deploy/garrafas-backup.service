[Unit]
Description=Gestão de Garrafas - backup privado cifrado
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/garrafas
UMask=0077
ExecStart=/usr/bin/docker compose --env-file /etc/garrafas/compose.env -f deploy/compose.server.yaml exec -T app python manage.py backup_data
TimeoutStartSec=900
# Install only after configuring the destination, GPG key, monitoring and restore.
# Access to Docker is privileged; restrict this unit and its configuration to root.
