# Template only: fill secrets outside Git, mode 0600. Never use development .env.
APP_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=garrafas.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://garrafas.example.invalid
TRUST_HTTPS_PROXY=1
DB_ENGINE=postgresql
DB_NAME=garrafas_live
DB_USER=garrafas_app
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=verify-full
PGSSLROOTCERT=/run/secrets/postgresql-ca.crt
LOGIN_ACCOUNT_LIMIT=5
LOGIN_ADDRESS_LIMIT=30
LOGIN_WINDOW_SECONDS=900
LOGIN_TRUSTED_PROXY_ADDRESSES=127.0.0.1
BACKUP_ROOT=/backups
BACKUP_RETENTION_COUNT=14
BACKUP_GPG_RECIPIENT=
GNUPGHOME=/home/garrafas/.gnupg
