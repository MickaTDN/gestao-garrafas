# Copie com `python3 scripts/bootstrap.py`; não use este ficheiro como credenciais.
APP_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=postgresql
DB_NAME=garrafas
DB_USER=garrafas
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Produção: APP_ENV=production, DJANGO_DEBUG=0, host/origem HTTPS reais,
# segredos próprios e PostgreSQL gerido com TLS (DB_SSLMODE=verify-full).
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_SSLMODE=prefer
